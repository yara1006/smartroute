        BuilderSvc["route_builder\n动态候选构建"]
        AdjustSvc["adjustment_service\n路线调整"]
        InsightSvc["route_insight\n路线分析/指标"]
        TraceSvc["trace_service\nTool Trace"]
    end

    subgraph Core["核心基础设施"]
        AMap["AMapClient\n高德 Web 服务\nTTL 缓存"]
        VectorStore["POIVectorStore\n中文 bigram 索引"]
        UserDB["UserProfileManager\nSQLite"]
        Config["Settings\n集中配置"]
    end

    subgraph External["外部服务"]
        DeepSeek["DeepSeek API"]
        AMapAPI["高德 Web 服务 API"]
    end

    Search & XiaoTuan & Favorites & Detail --> API
